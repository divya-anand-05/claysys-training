  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Questions": {
        "required": [
          "correctAnswer",
          "course",
          "optionA",
          "optionB",
          "optionC",
          "optionD",
          "questionText"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "course": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "questionText": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "optionA": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "optionB": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "optionC": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "optionD": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "correctAnswer": {
            "minLength": 1,
            "pattern": "^[A-D]$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Result": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "course": {
            "type": "string",
            "nullable": true
          },
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "totalMarks": {
            "type": "integer",
            "format": "int32"
          },
          "dateTaken": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "User": {
        "required": [
          "email",
          "name",
          "password"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          },
          "role": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "JWT Authorization header. Enter 'Bearer' [space] your token",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
